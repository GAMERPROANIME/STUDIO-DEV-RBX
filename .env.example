# OMNIBRIDGE AI — configuration (copier en .env)
# Toutes les variables sont optionnelles : les valeurs par défaut sont sûres.

# Transport du serveur MCP : both | stdio | http
OMNIBRIDGE_TRANSPORT=both

# Écoute HTTP — 127.0.0.1 par défaut : jamais exposé à l'extérieur
OMNIBRIDGE_HTTP_HOST=127.0.0.1
OMNIBRIDGE_HTTP_PORT=8765

# Niveau de permission global : 1 lecture | 2 assistance | 3 automatisation | 4 sensible
OMNIBRIDGE_PERMISSION_LEVEL=2

# Workspace autorisé pour toutes les opérations fichier (sandbox)
OMNIBRIDGE_WORKSPACE=.

# Répertoire de données (SQLite, token, sauvegardes, manifests du bridge)
# OMNIBRIDGE_DATA_DIR=~/.omnibridge

# Token Bearer : généré automatiquement dans <data>/token.txt si vide
# OMNIBRIDGE_TOKEN=
# OMNIBRIDGE_REQUIRE_TOKEN=1

# Roblox Studio MCP officiel (sinon découverte automatique)
# Windows : %LOCALAPPDATA%\Roblox\mcp.bat
# macOS   : /Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
# ROBLOX_STUDIO_MCP_COMMAND=
# ROBLOX_STUDIO_MCP_ARGS=

# Liste blanche de domaines pour web_open / web_extract (vide = tout domaine)
# OMNIBRIDGE_WEB_ALLOWED_HOSTS=create.roblox.com,luau.org,modelcontextprotocol.io

# Limites agent
# OMNIBRIDGE_AGENT_MAX_STEPS=40
# OMNIBRIDGE_AGENT_MAX_RETRIES=2
# OMNIBRIDGE_AGENT_STEP_TIMEOUT_MS=120000
# OMNIBRIDGE_MAX_FILE_BYTES=2000000

# Logs : DEBUG | INFO | WARNING | ERROR (toujours sur stderr)
# OMNIBRIDGE_LOG_LEVEL=INFO

# Dashboard et plugins (chemins personnalisés)
# OMNIBRIDGE_DASHBOARD_DIR=./dashboard
# OMNIBRIDGE_PLUGINS_DIR=./plugins
